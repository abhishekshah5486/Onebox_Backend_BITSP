      "Llama-3.3-70B": {
        "id": "Llama-3.3-70B",
        "name": "Llama 3.3 70B"
      },
      "qwen3-14b": {
        "id": "qwen3-14b",
        "name": "Qwen3 14B"
      },
      "gpt-4.1": {
        "id": "gpt-4.1",
        "name": "GPT-4.1"
      }
    }
  },
  "ifm": {
    "id": "ifm",
    "name": "IFM (MBZUAI)",
    "npm": "@ai-sdk/openai-compatible",
    "api": "https://api.ifm.ai/v1",
    "doc": "https://docs.ifm.ai/",
    "env": ["IFM_API_KEY"],
    "models": {
      "IFM/K2-Horizon-375B-A23B": {
        "id": "IFM/K2-Horizon-375B-A23B",
        "name": "K2 Horizon",
        "reasoning": true,
        "limit": {
          "context": 512000
