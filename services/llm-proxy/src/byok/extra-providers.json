  "core42": {
    "id": "core42",
    "name": "Core42 Compass (G42)",
    "npm": "@ai-sdk/openai-compatible",
    "api": "https://api.core42.ai/v1",
    "doc": "https://www.core42.ai/compass/documentation/chat-completion",
    "env": ["CORE42_API_KEY"],
    "models": {
      "k2-think-core42": {
        "id": "k2-think-core42",
        "name": "K2 Think",
