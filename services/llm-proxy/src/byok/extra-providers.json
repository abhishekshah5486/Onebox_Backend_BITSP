      },
      "IFM/Jais-3-MoVA-36B-A4B": {
        "id": "IFM/Jais-3-MoVA-36B-A4B",
        "name": "Jais 3",
        "limit": {
          "context": 512000
        }
      }
    }
  },
  "falcon": {
    "id": "falcon",
    "name": "Falcon (TII, self-hosted)",
    "npm": "@ai-sdk/openai-compatible",
    "api": "http://localhost:8000/v1",
    "doc": "https://github.com/tiiuae/Falcon-H1",
