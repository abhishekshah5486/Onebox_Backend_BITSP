    "doc": "https://docs.compactif.ai/",
    "env": ["MULTIVERSE_API_KEY"],
    "models": {
      "glm-5-3": {
        "id": "glm-5-3",
        "name": "GLM 5.3 (CompactifAI)"
      },
      "glm-5-2": {
        "id": "glm-5-2",
        "name": "GLM 5.2 (CompactifAI)"
      },
      "quasar-1-2-358b": {
