{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ALLOW_PRIVATE_MAIL_HOSTS", "ALLOW_PRIVATE_WEBHOOK_HOSTS"]
    }
  }
}
