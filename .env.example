# Copy to .env and fill in. Never commit .env.

# Supabase: Dashboard > Connect > "Session pooler" string, with [YOUR-PASSWORD] replaced
# (URL-encode special characters in the password, e.g. @ -> %40).
DATABASE_URL=

# MongoDB Atlas. Tests use a temporary database on the same cluster and drop it afterwards.
MONGO_URI=

# Local infra (docker compose)
REDIS_URL=redis://localhost:6379
# Attachment storage: any S3-compatible store (docker compose runs SeaweedFS on 8333).
BLOB_ENDPOINT=http://localhost:8333
BLOB_BUCKET=onebox-attachments
BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=
ELASTICSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Semantic search: the embedding model used until a user picks another in Settings > AI.
# Local models are any embedding model pulled into Ollama (e.g. `ollama pull nomic-embed-text`);
# hosted ones (OpenAI, Gemini) need that provider's key above.
EMBEDDING_DEFAULT_MODEL=ollama/bge-m3
OLLAMA_URL=http://localhost:11434
# Providers users can bring their own keys for, from the models.dev catalogue.
PROVIDER_CATALOG_URL=https://models.dev/api.json
# Providers listed first for own keys, in order (models.dev ids); the rest follow by name.
PROVIDER_FEATURED=openai,anthropic,google,deepseek,openai-compatible,openrouter,azure,amazon-bedrock,lmstudio,google-vertex,cohere,togetherai,xai,groq,fireworks-ai,mistral,minimax
# Lets users point their models at servers on this machine or network (e.g. LM Studio). Keep false in production.
PROVIDER_ALLOW_PRIVATE_URLS=false

# Encrypts stored credentials (IMAP passwords, Slack webhooks) in the database.
# Generate once with: openssl rand -base64 32. Losing it makes stored credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# Google Drive (OAuth web client + Picker API key). Leave empty to keep Drive off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# OneDrive (Microsoft Entra app registration, personal + work accounts). Leave empty to keep it off.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Dropbox (app console app key and secret). Leave empty to keep it off.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Payments service. PAYMENTS_MODE picks test or live keys; DEFAULT_PAYMENT_PROVIDER is used
# when both are set up and the user doesn't choose (razorpay or stripe).
PAYMENTS_MODE=test
DEFAULT_PAYMENT_PROVIDER=razorpay
# Razorpay: test keys from the dashboard in Test Mode; live keys only in production.
RAZORPAY_TEST_API_KEY=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_API_KEY=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe: sandbox keys from the dashboard; the webhook secret from `stripe listen` or a webhook endpoint.
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Billing: a credit is worth ₹1; an AI call uses its model cost × USD_TO_INR × CREDIT_MARKUP.
USD_TO_INR=85
CREDIT_MARKUP=2

# Lets users keep search vectors and files in stores on this machine or network. Keep false in production.
ALLOW_PRIVATE_STORAGE_HOSTS=false
