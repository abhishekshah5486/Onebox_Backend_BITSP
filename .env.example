# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# Supabase Postgres: pooled for services, direct for migrations
DATABASE_URL=
DATABASE_DIRECT_URL=

# MongoDB Atlas (M0). Tests create and drop their own onebox_test_<id> database.
MONGO_URI=
MONGO_TEST_URI=

# Local infra (docker compose)
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333

# LLM providers (model IDs are configured per purpose in the ai service)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 32-byte base64 key for encrypting stored credentials: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
