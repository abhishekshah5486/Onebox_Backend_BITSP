# Copy to .env and fill in. Never commit .env.

# Supabase: Dashboard > Connect > "Session pooler" string, with [YOUR-PASSWORD] replaced
# (URL-encode special characters in the password, e.g. @ -> %40).
DATABASE_URL=

# MongoDB Atlas. Tests use a temporary database on the same cluster and drop it afterwards.
MONGO_URI=

# Local infra (docker compose)
REDIS_URL=redis://localhost:6379
# Attachment storage: any S3-compatible store (docker compose runs SeaweedFS on 8333).
BLOB_ENDPOINT=http://localhost:8333
BLOB_BUCKET=onebox-attachments
BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=
ELASTICSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Encrypts stored credentials (IMAP passwords, Slack webhooks) in the database.
# Generate once with: openssl rand -base64 32. Losing it makes stored credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=
